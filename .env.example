# API key for the aipaibox provider (server-side only).
AI_API_KEY="YOUR_API_KEY"

# Optional deployment image (for docker compose).
# Examples:
# DAYPLAN_IMAGE="ghcr.io/<github-owner>/dayplan:latest"
# DAYPLAN_IMAGE="<dockerhub-user>/dayplan:latest"
# DAYPLAN_IMAGE="dayplan-local:latest"
DAYPLAN_IMAGE="exekiel179/dayplan:latest"

# Base URL for the provider.
AI_BASE_URL="https://api.aipaibox.com"

# Model used in both /v1/chat/completions and /v1beta fallback.
AI_MODEL="gemini-3.1-pro-preview"

# Login auth credentials (single account mode).
AUTH_USERNAME="admin"
AUTH_PASSWORD="admin123456"

# Optional multi-account JSON (takes precedence over AUTH_USERNAME/AUTH_PASSWORD).
# Example:
# AUTH_USERS=[{"username":"admin","password":"admin123456"},{"username":"alice","password":"alice123"}]
# AUTH_USERS=""

# Allow self-service registration from frontend (true/false).
AUTH_ALLOW_REGISTRATION="true"

# Session lifetime in milliseconds (default 24h).
SESSION_TTL_MS="86400000"
